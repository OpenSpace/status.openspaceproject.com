{
  "extends": "@openspace/shared-configs/tsconfig.json",

  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": ["node"],

    /* The scripts are run directly by Node through its built-in type stripping */
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true
  },
  "include": ["scripts", "src/types.ts", "vite.config.ts"]
}
